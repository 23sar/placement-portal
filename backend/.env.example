# Backend environment variables
# Copy this file to .env and fill in your values — never commit .env

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=placement_portal

JWT_SECRET=replace-with-a-random-32+-character-string

# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Optional — defaults to 5000
PORT=5000
